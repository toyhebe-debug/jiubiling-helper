{
  "name": "jiubiling-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "vars": {
    "CORS_ORIGINS": "https://toyhebe-debug.github.io,http://127.0.0.1:5174,http://localhost:5174"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jiubiling-family",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
